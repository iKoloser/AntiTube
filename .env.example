# URL pública que el navegador usará para consultar la API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Puerto y origen autorizado de la API Express.
BACKEND_PORT=4000
CORS_ORIGIN=http://localhost:3000

# Tiempo máximo de consulta de metadatos mediante yt-dlp, en milisegundos.
METADATA_TIMEOUT_MS=60000
# Las playlists pueden necesitar más tiempo porque yt-dlp debe enumerar sus elementos.
PLAYLIST_METADATA_TIMEOUT_MS=180000

# Nombre o ruta completa del ejecutable local. Normalmente basta con yt-dlp.
YTDLP_BIN=yt-dlp
YTDLP_JS_RUNTIME=node

# Reconocimiento musical con ShazamIO.
PYTHON_BIN=python
SHAZAM_TIMEOUT_MS=60000
FFMPEG_TIMEOUT_MS=30000

# Directorio de salida relativo al backend (se crea automáticamente).
DOWNLOAD_DIR=../downloads
# Límite y tiempo máximo por descarga.
MAX_DOWNLOAD_BYTES=524288000
DOWNLOAD_TIMEOUT_MS=1800000
MAX_PLAYLIST_ITEMS=50
