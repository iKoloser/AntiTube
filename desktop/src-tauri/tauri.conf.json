{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AntiTube",
  "version": "0.2.1",
  "identifier": "com.ikoloser.antitube",
  "build": {
    "frontendDist": "../../frontend/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": {
      "script": "pnpm --filter @antitube/frontend dev",
      "cwd": "../.."
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "iKoloser",
    "shortDescription": "Analiza y descarga contenido multimedia autorizado",
    "longDescription": "AntiTube es una aplicación local y privada para buscar, descargar y reproducir música y vídeo, recortar fragmentos y reconocer canciones.",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend/": "backend/",
      "resources/node/": "node/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    }
  }
}
